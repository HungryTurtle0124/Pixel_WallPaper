<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PixelWallpaper.Renderer</RootNamespace>
    <ApplicationManifest>../../src/PixelWallpaper.Renderer/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the actual implementation; no test framework or shipping dependency. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <Compile Include="../../src/PixelWallpaper.Renderer/Windows/*.cs" />
    <Compile Include="../../src/PixelWallpaper.Renderer/Runtime/*.cs" />
    <Compile Include="../../src/PixelWallpaper.Renderer/Timing/*.cs" />
    <Compile Include="../../src/PixelWallpaper.Renderer/Rendering/*.cs" />
    <Compile Include="../../src/PixelWallpaper.Renderer/Scenes/**/*.cs" />
    <None Include="../../src/PixelWallpaper.Renderer/Assets/Backgrounds/rainy-forest.png"
          Link="Assets/Backgrounds/rainy-forest.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../src/PixelWallpaper.Renderer/Rendering/Shaders/*.cso" WithCulture="false"
                      LogicalName="PixelWallpaper.Renderer.Rendering.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
